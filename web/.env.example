# Google OAuth (required)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth (required)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Anthropic Claude API (required for AI day optimization)
ANTHROPIC_API_KEY=

# Optional: authenticated Playwright E2E (Sprint 5)
# E2E_GOOGLE_EMAIL=
# E2E_GOOGLE_PASSWORD=

# Upstash Redis (required for shared rate limiting in multi-instance production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
